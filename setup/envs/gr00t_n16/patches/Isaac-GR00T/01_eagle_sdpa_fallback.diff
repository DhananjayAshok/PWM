+def sdpa_attention_forward_for_packing(
+    module, query, key, value, attention_mask=None, dropout=0.0, scaling=None,
+    seq_len_list=None, is_causal=False, **kwargs,
+):
+    """[pwm patch] SDPA equivalent of flash_attention_forward_for_packing: all images/windows are packed
+    along the sequence dim of a batch-1 tensor (B, H, S, D); attend within each segment only."""
+    if seq_len_list is None or len(seq_len_list) <= 1:
+        out = F.scaled_dot_product_attention(query, key, value, dropout_p=dropout, scale=scaling, is_causal=False)
+    else:
+        outs = [
+            F.scaled_dot_product_attention(q, k, v, dropout_p=dropout, scale=scaling, is_causal=False)
+            for q, k, v in zip(query.split(seq_len_list, dim=2), key.split(seq_len_list, dim=2), value.split(seq_len_list, dim=2))
+        ]
+        out = torch.cat(outs, dim=2)
+    return out.transpose(1, 2).contiguous(), None
